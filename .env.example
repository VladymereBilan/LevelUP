# --- Supabase ---
# Local development and every automated test suite point here — NOT the hosted project, which
# is PRODUCTION (see CLAUDE.md "Production" and docs/PRODUCTION.md). From packages/db, run:
#   npx supabase start
# It prints a local API URL (http://127.0.0.1:<port>) and the local anon/service_role keys —
# copy those three values in below. Never put the hosted project's values here; packages/db's
# test suites refuse to run (loudly, not silently) against anything but a local host.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sign-In (Google Cloud project) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EXPO_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- apps/web (Next.js) ---
# Same local-vs-production rule as above for local dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- apps/mobile (Expo) ---
# Same local-vs-production rule as above for local dev. apps/mobile reads .env* from
# apps/mobile/, not this root file — see apps/mobile/README.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=

# --- Production-only CLI script flag (do NOT persist this here) ---
# packages/db's seed/backfill-titles CLI scripts (and any future one-off maintenance script)
# refuse to touch a non-local SUPABASE_URL unless CONFIRM_PRODUCTION_WRITE=true is passed
# inline on that specific command — e.g.:
#   CONFIRM_PRODUCTION_WRITE=true pnpm --filter @levelup/db seed <userId> <templateId>
# Never add CONFIRM_PRODUCTION_WRITE as a stored line in .env.local — that would silently
# re-enable production writes for every future script run, defeating the point of the flag.
